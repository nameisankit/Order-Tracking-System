# ========== Local Docker Compose ==========
POSTGRES_DB=order_tracking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeThisPostgresPassword

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/order_tracking_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeThisPostgresPassword

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_SSL=false

JWT_SECRET=replaceWithAtLeast32CharSecret
JWT_EXPIRATION=86400000

SPRING_MVC_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

REACT_APP_API_BASE_URL=http://localhost:8080/api
REACT_APP_WS_URL=http://localhost:8080/ws

# ========== Neon (PostgreSQL) — Render backend ==========
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_neon_password

# ========== Upstash (Redis) — Render backend ==========
# SPRING_DATA_REDIS_HOST=xxx.upstash.io
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=your_upstash_token
# SPRING_DATA_REDIS_SSL=true

# ========== Vercel (frontend only) ==========
# REACT_APP_API_BASE_URL=https://order-tracking-backend.onrender.com/api
# REACT_APP_WS_URL=https://order-tracking-backend.onrender.com/ws

# ========== Render CORS (include Vercel URL) ==========
# SPRING_MVC_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
